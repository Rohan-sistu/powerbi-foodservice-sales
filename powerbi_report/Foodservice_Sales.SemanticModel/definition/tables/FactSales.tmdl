	column discount_band_sort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8b389f86-4bf3-303a-d1be-25ae5d6d9743
		summarizeBy: none
		sourceColumn: discount_band_sort

		annotation SummarizationSetBy = User

	column order_date
		dataType: dateTime
		isHidden
		formatString: dd.MM.yyyy
		lineageTag: d126bd70-3399-f1d7-1b2b-fd0465748799
		summarizeBy: none
		sourceColumn: order_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column customer_id
		dataType: string
		isHidden
		lineageTag: 63da0b7b-2289-c816-4d93-f8c195e87320
		summarizeBy: none
