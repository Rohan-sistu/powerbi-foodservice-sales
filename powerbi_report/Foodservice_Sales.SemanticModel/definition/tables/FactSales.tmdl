/// One row per cleaned order line (duplicates removed, sign errors fixed), enriched with order date, customer and channel.
table FactSales
	lineageTag: b8c809c8-657a-ecbb-020c-0a5a1c571ef1

	column line_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 602ca0ae-d976-ba59-330d-80a1e0350cf8
		summarizeBy: none
		sourceColumn: line_id

		annotation SummarizationSetBy = User

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: a83ba918-f238-0c8d-21bd-464a2e8cf07e
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = User

	column product_id
