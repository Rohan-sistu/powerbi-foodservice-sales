		formatString: #,##0.00
		lineageTag: 7f8c7876-2f35-0daf-2a3f-8b3d22622153
		summarizeBy: none
		sourceColumn: discount_pct

		annotation SummarizationSetBy = User

	column line_type
		dataType: string
		lineageTag: 5b5376f0-565e-06e8-3d2e-f96f7ace8914
		summarizeBy: none
		sourceColumn: line_type

		annotation SummarizationSetBy = User

	column line_amount_eur
		dataType: double
		formatString: #,##0.00
		lineageTag: 39813e57-1542-bf1f-8244-5393bdde5c1e
		summarizeBy: none
		sourceColumn: line_amount_eur

		annotation SummarizationSetBy = User

	column discount_band
		dataType: string
		lineageTag: 1d9fa56b-a079-731d-33a1-9151805037d6
		summarizeBy: none
		sourceColumn: discount_band
		sortByColumn: discount_band_sort

