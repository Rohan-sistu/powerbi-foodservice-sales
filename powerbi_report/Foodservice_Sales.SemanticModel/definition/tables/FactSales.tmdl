		isHidden
		lineageTag: 3a301b52-a79a-262c-1013-918e9b435af0
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = User

	column quantity
		dataType: string
		lineageTag: 36529f25-c958-024c-b092-a8719b4d9486
		summarizeBy: none
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	column unit_price_eur
		dataType: double
		formatString: #,##0.00
		lineageTag: 1a116090-56b5-324d-f925-52fe345b37b0
