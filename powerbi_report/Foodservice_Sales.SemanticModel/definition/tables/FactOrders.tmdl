/// One row per order; on_time = 1 if delivered on or before the promised date.
table FactOrders
	lineageTag: a5aaef07-ec82-4b31-03d9-2dffb8d0fc67

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: 31c76906-2c2e-46fb-367f-da2ec6f2ea3a
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = User

	column order_date
		dataType: dateTime
		isHidden
		formatString: dd.MM.yyyy
		lineageTag: 5750dbc7-8333-900e-ef99-712e46dafe67
		summarizeBy: none
		sourceColumn: order_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column customer_id
		dataType: string
		isHidden
		lineageTag: 40224e50-0501-0440-ae54-4fd8849e62bd
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = User

	column channel
		dataType: string
		lineageTag: 4293d1ca-c158-bf27-9830-960536fc47ec
		summarizeBy: none
		sourceColumn: channel

		annotation SummarizationSetBy = User

	column promised_delivery_date
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: 6c96008e-5959-26f8-c720-8b76f149de33
		summarizeBy: none
		sourceColumn: promised_delivery_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column actual_delivery_date
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: 933fff31-7046-32bc-7acc-e89301131f4e
		summarizeBy: none
		sourceColumn: actual_delivery_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column on_time
		dataType: int64
		formatString: 0
		lineageTag: 88ec2c20-dd45-d8ad-e2d8-18ed477fa853
		summarizeBy: none
		sourceColumn: on_time

		annotation SummarizationSetBy = User

	partition FactOrders = m
		mode: import
		source =
				let
				    Source   = Csv.Document(File.Contents(DataFolder & "orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers  = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types    = Table.TransformColumnTypes(Headers, {{"order_id", Int64.Type}, {"order_date", type date}, {"promised_delivery_date", type date}, {"actual_delivery_date", type date}}, "en-US"),
				    TrimId   = Table.TransformColumns(Types, {{"customer_id", Text.Trim, type text}}),
				    Channel  = Table.TransformColumns(TrimId, {{"channel", each Translate(_, {{"Außendienst", "Field sales"}, {"Telefon", "Phone"}, {"Webshop", "Web shop"}}), type text}}),
				    OnTime   = Table.AddColumn(Channel, "on_time", each if [actual_delivery_date] <= [promised_delivery_date] then 1 else 0, Int64.Type)
				in
				    OnTime

	annotation PBI_ResultType = Exception

